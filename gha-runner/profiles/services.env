# Profile: services  -- AMD Ryzen 9 5950X guest, 24 vCPU, 46G RAM.
#
# Sourced by gha-vm.sh after config.env, so anything set here wins. Matched by
# short hostname; rename the file to the machine-id to survive a host rename.
#
# This box is not a dedicated CI machine. It runs llama-server, minio, clamd and
# a stack of containers that hold ~18G resident, and its docker graph already
# occupies 317G of the 982G volume. It also runs under QEMU, so runner VMs nest
# and are slower than on bare metal. Two slots is the deliberate ceiling.

MAX_SLOTS=2

# GitHub's own hosted runners are 4 vCPU / 16G. 4 vCPU / 8G is the closest fit
# that leaves this host's real workload untouched at two concurrent jobs.
VM_CPUS=4
VM_MEM=8G

# Virtual size only -- the overlay is sparse and starts near zero. DISK_PER_SLOT_GB
# is the number capacity planning actually spends.
VM_DISK=60G
DISK_PER_SLOT_GB=30

# Floor, not the final value: AUTOTUNE raises this to cover whatever is resident
# when capacity runs (~22G here). Kept at 16 so the arithmetic is still sane if
# someone sets AUTOTUNE=0.
HOST_RESERVE_GB=16

# Docker can reclaim the space it freed at any time. Refuse to start a VM with
# less than this free rather than wedge the host that serves everything else.
MIN_FREE_GB=40

# Already nested one level. Exposing SVM again to the job would be a third level
# and is not something this host should offer.
NESTED_VIRT=0
