# Fixture for tests/run.sh: every host-discovered value is pinned so `render`
# is deterministic on any machine.
SCOPE=org
GITHUB_ORG=example-org
AUTH_MODE=app
GITHUB_APP_ID=1
GITHUB_APP_KEY=/etc/gha-vm/app.pem
RUNNER_VERSION=2.336.0

HOST_ARCH=x86_64
GHA_UID=999
NAME_PREFIX=gha-test
HOST_PROFILE=test
AUTOTUNE=0

VM_CPUS=4
VM_MEM=8G
VM_DISK=80G
STOP_GRACE_SEC=900

NET_DNS_ADDRS="10.0.0.53 fd00::53"
NET_HOST_ADDRS="203.0.113.10 2001:db8::10"
NET_ENDPOINT_ADDRS="10.10.0.4 [fd00:10::4]:8443"
NET_ALLOW_CIDRS="192.168.50.0/24,fd00:50::/64"
