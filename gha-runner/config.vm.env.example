# /etc/gha-vm/config.env  -- root-owned, chmod 0640, group gha.
# This file never enters the guest.

RUNNER_VERSION=2.336.0
# Pin the release tarball hash. `gha-vm.sh image` resolves it from the release
# notes when unset and refuses to build if it cannot; ALLOW_UNVERIFIED_RUNNER=1
# overrides that. `gha-vm.sh upgrade` rewrites both lines.
#RUNNER_SHA256=
#ALLOW_UNVERIFIED_RUNNER=0

# Let the weekly upgrade timer move RUNNER_VERSION to the latest release.
# GitHub rejects runners more than 30 days behind, so leave this on.
AUTO_RUNNER_VERSION=1

UBUNTU_RELEASE=26.04
# Override if the release filename changes; check the directory listing at
# https://cloud-images.ubuntu.com/releases/26.04/release/
#CLOUDIMG_NAME=ubuntu-26.04-server-cloudimg-amd64.img

# Resolvers the guest uses while `gha-vm image` builds it -- the cloud image has
# no usable resolv.conf offline, since systemd-resolved writes it at boot.
# Restored before the golden image is sealed, so runner VMs are unaffected.
# 169.254.2.3 is the DNS forwarder inside the qemu slirp NAT that libguestfs
# runs the build appliance behind; the public resolvers are only a fallback.
#GUEST_DNS="169.254.2.3 1.1.1.1 8.8.8.8"

# --- auth -------------------------------------------------------------------
# The app key must be readable by the gha user: chown root:gha, chmod 0640.
#
# The app needs exactly one permission, and it differs by SCOPE below:
#   SCOPE=org   Organization permissions > Self-hosted runners > Read and write
#   SCOPE=repo  Repository permissions   > Administration      > Read and write
# A PAT instead needs the admin:org scope (org) or repo scope (repo), plus SSO
# authorization if the org enforces it.
AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_KEY=/etc/gha-vm/app.pem
#GITHUB_PAT=

# --- scope ------------------------------------------------------------------
# There is no user-account runner scope. On a personal account, "all my repos"
# means one pool per repo. Move them into an org and use SCOPE=org.
SCOPE=org
GITHUB_ORG=
#GITHUB_REPO=owner/name

# Ignored when SCOPE=repo; repo-scoped runners have no runner groups.
RUNNER_GROUP_ID=1
# The host's short hostname is appended automatically so workflows can pin a
# machine with runs-on: [self-hosted, <hostname>].
#RUNNER_LABELS=self-hosted,linux,x64,vm,ephemeral,docker

# --- vm sizing (per concurrency slot) ---------------------------------------
# `gha-vm.sh capacity` turns these into a slot count for this host.
VM_CPUS=4
VM_MEM=8G
# Also the golden image's filesystem size: `image` expands the cloud image's
# ~3.5G root to this before installing anything, so it must leave at least 6G
# free after the guest packages land or the build stops with a clear error.
VM_DISK=80G

# Expose VMX/SVM to the guest. Off by default: nested virt widens the KVM
# attack surface that the whole isolation model rests on.
NESTED_VIRT=0

# Hard ceiling on one job, matching GitHub's own 6h limit.
MAX_LIFETIME=21600
# Kill a VM that never reaches the runner. Catches a broken golden image before
# it burns a slot for six hours.
BOOT_TIMEOUT=420
# Refuse to start a VM below this much free space under STATE_DIR.
MIN_FREE_GB=20

# Refuse to start a slot unless the nftables isolation rules are loaded. Set to
# 0 only if you deliberately want jobs to reach this host and your LAN.
REQUIRE_ISOLATION=1

# --- host setup -------------------------------------------------------------
# unattended-upgrades, apt-daily and an unfinished do-release-upgrade all hold
# the apt locks. `deps` waits this long per attempt rather than failing.
APT_LOCK_WAIT=120
APT_LOCK_TRIES=5

# --- host profile -----------------------------------------------------------
# One checkout can serve a fleet. `deps` installs profiles/*.env to
# /etc/gha-vm/profiles/ and each host loads the one matching, in order:
# HOST_PROFILE, <machine-id>.env, <short hostname>.env, default.env, none.
# A profile is sourced AFTER this file, so anything it sets wins -- keep
# credentials and scope here, sizing there. See `gha-vm.sh profile`.
#HOST_PROFILE=

# --- capacity planning ------------------------------------------------------
# A floor, not the final value. With AUTOTUNE=1 the reserve is raised to cover
# whatever is resident when capacity runs, so a box that also serves other
# workloads is sized on its real spare memory rather than its nameplate.
HOST_RESERVE_GB=8
AUTOTUNE=1
AUTOTUNE_HEADROOM_GB=4
CPU_OVERCOMMIT=2
DISK_PER_SLOT_GB=30

# Hard ceiling on slots regardless of what the hardware could carry. 0 = let
# the hardware decide. Normally set in a profile, not here.
MAX_SLOTS=0

# --- host paths -------------------------------------------------------------
# Put this on NVMe. Every job writes a fresh qcow2 overlay here.
STATE_DIR=/var/lib/gha-vm
GHA_USER=gha
