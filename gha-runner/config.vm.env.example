# /etc/gha-vm/config.env  -- root-owned, chmod 0640, group gha.
# This file never enters the guest.

RUNNER_VERSION=2.336.0
# Pin the release tarball hash. `gha-vm.sh image` resolves it from the release
# notes when unset and refuses to build if it cannot; ALLOW_UNVERIFIED_RUNNER=1
# overrides that. `gha-vm.sh upgrade` rewrites both lines.
#RUNNER_SHA256=
#ALLOW_UNVERIFIED_RUNNER=0

# Let the weekly upgrade timer move RUNNER_VERSION to the latest release.
# GitHub rejects runners more than 30 days behind, so leave this on.
AUTO_RUNNER_VERSION=1
# always: the weekly timer rebuilds the golden image even when the runner
# version did not change, so Ubuntu package updates land within a week.
# version: rebuild only when RUNNER_VERSION moves.
#UPGRADE_REBUILD=always

UBUNTU_RELEASE=26.04
# Override if the release filename changes; check the directory listing at
# https://cloud-images.ubuntu.com/releases/26.04/release/
# The default follows CLOUDIMG_ARCH (amd64 on x86_64 hosts, arm64 on aarch64).
#CLOUDIMG_NAME=ubuntu-26.04-server-cloudimg-amd64.img
#CLOUDIMG_BASE=https://cloud-images.ubuntu.com/releases/26.04/release

# --- image build and rollback -----------------------------------------------
# Boot the freshly built image once before it replaces the golden image; the
# guest must print its self-test marker within BOOT_TIMEOUT or the build fails
# and the current golden image stays in place.
#IMAGE_SELFTEST=1
# Keep the outgoing golden image as golden.qcow2.prev so `gha-vm.sh rollback`
# can swap it back. Costs one extra image's worth of disk under STATE_DIR.
#GOLDEN_KEEP_PREVIOUS=1
# `doctor` warns when the golden image is older than this (the weekly timer
# should keep it under 7 days).
#GOLDEN_MAX_AGE_DAYS=21

# Packages installed into the golden image. GUEST_PACKAGES is the base set the
# runner and gha-job.sh rely on; put additions in GUEST_EXTRA_PACKAGES so the
# base can change across versions without you re-merging it.
#GUEST_PACKAGES=docker.io,git,jq,curl,unzip,zip,ca-certificates,build-essential,rsync,gnupg,gh,xz-utils,procps,libxi6,libpulse0,libxkbfile1,libgbm1,libsm6,libice6
#GUEST_EXTRA_PACKAGES=
# Every executable *.sh here runs inside the image build (as root, with
# GUEST_HTTP_PROXY exported) after packages are installed. Use it to bake
# tools or config that a workflow step would otherwise have to install on
# every job.
#IMAGE_HOOK_DIR=/etc/gha-vm/image.d
# Copied into the image as /usr/local/bin/gha-pre-job.sh and run as root on
# every boot before the runner starts. A non-zero exit refuses the job.
#GUEST_PRE_JOB_HOOK=
# Resolvers for runner VMs at job time (space or comma separated). Empty uses
# the slirp forwarder, which hands the guest whatever the host resolves with.
# Pinned resolvers get the same port-53 hole in the isolation rules as the
# host's own, so one inside a blocked range still answers.
#GUEST_RUNTIME_DNS=

# Resolvers the guest uses while `gha-vm image` builds it -- the cloud image has
# no usable resolv.conf offline, since systemd-resolved writes it at boot.
# Restored before the golden image is sealed, so runner VMs are unaffected.
# 169.254.2.3 is the DNS forwarder inside the qemu slirp NAT that libguestfs
# runs the build appliance behind; the public resolvers are only a fallback.
#GUEST_DNS="169.254.2.3 1.1.1.1 8.8.8.8"

# --- github endpoint --------------------------------------------------------
# GitHub Enterprise Server: set the server URL and the API URL follows as
# <server>/api/v3. github.com needs neither. Runner tarballs still come from
# github.com/actions/runner unless RUNNER_DOWNLOAD_BASE points at a mirror.
#GITHUB_SERVER_URL=https://github.com
#GITHUB_API_URL=
#RUNNER_DOWNLOAD_BASE=https://github.com/actions/runner/releases/download

# Outbound proxy for the host's own curl: API calls, the cloud image and its
# checksums, the release lookup. Exported as-is.
#HTTPS_PROXY=
#HTTP_PROXY=
#NO_PROXY=
# Proxy baked into the guest: apt and the runner download during the image
# build, then the runner, its job steps and dockerd at job time. The guest
# reaches the host's network through slirp, so this must be reachable from
# the host. Empty leaves the guest proxy-free.
#GUEST_HTTP_PROXY=
#GUEST_NO_PROXY=localhost,127.0.0.1,::1,10.0.2.2
# Addresses of the GitHub endpoints and proxies above, pinned instead of
# resolved at each slot start. Each gets an accept on its port ahead of every
# drop, which is what lets a GitHub Enterprise Server or a proxy on the LAN
# through the isolation rules. Space-separated ADDR[:PORT] or [V6ADDR]:PORT;
# port 443 when none is given. Normally leave empty.
#NET_ENDPOINT_ADDRS=

# Per-request ceiling and retry count for GitHub API calls.
#API_MAXTIME=30
#API_RETRY=3

# --- auth -------------------------------------------------------------------
# The app key must be readable by the gha user: chown root:gha, chmod 0640.
#
# The app needs exactly one permission, and it differs by SCOPE below:
#   SCOPE=org   Organization permissions > Self-hosted runners > Read and write
#   SCOPE=repo  Repository permissions   > Administration      > Read and write
# A PAT instead needs the admin:org scope (org) or repo scope (repo), plus SSO
# authorization if the org enforces it.
AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_KEY=/etc/gha-vm/app.pem
#GITHUB_PAT=

# --- scope ------------------------------------------------------------------
# There is no user-account runner scope. On a personal account, "all my repos"
# means one pool per repo. Move them into an org and use SCOPE=org.
SCOPE=org
GITHUB_ORG=
#GITHUB_REPO=owner/name

# Ignored when SCOPE=repo; repo-scoped runners have no runner groups. Name a
# group with RUNNER_GROUP and each supervisor looks the id up once, at its
# first registration; the id below only applies when RUNNER_GROUP is empty.
RUNNER_GROUP_ID=1
#RUNNER_GROUP=
# The arch label follows RUNNER_ARCH (x64 or arm64). Labels are trimmed and
# de-duplicated before registration.
#RUNNER_LABELS=self-hosted,linux,x64,vm,ephemeral,docker
# Append the host's short hostname so workflows can pin a machine with
# runs-on: [self-hosted, <hostname>]. Applies to a custom RUNNER_LABELS too.
#RUNNER_LABELS_APPEND_HOST=1
# Runner names are <prefix>-<slot>-<random>; defaults to gha-<short hostname>.
#NAME_PREFIX=

# --- vm sizing (per concurrency slot) ---------------------------------------
# `gha-vm.sh capacity` turns these into a slot count for this host.
VM_CPUS=4
VM_MEM=8G
# Also the golden image's filesystem size: `image` expands the cloud image's
# ~3.5G root to this before installing anything, so it must leave at least 6G
# free after the guest packages land or the build stops with a clear error.
VM_DISK=80G

# Per-slot overrides: slot <n> runs a VM of VM_MEM_<n> / VM_CPUS_<n> and
# registers with RUNNER_LABELS_EXTRA_<n> on top of the labels above, so a
# workflow can ask for it with runs-on: [self-hosted, large]. Slots are
# numbered from 1; a bare number is GiB like VM_MEM.
#VM_MEM_1=16G
#VM_CPUS_1=8
#RUNNER_LABELS_EXTRA_1=large

# --- fleet memory -----------------------------------------------------------
# One memory budget shared by every runner VM instead of a fixed share each.
# A slot registers a runner only while the VMs' real use plus that slot's full
# size fits in it, so light jobs leave room for more slots and a heavy load
# holds back new jobs rather than squeezing running ones. The slot units run
# in ghavm.slice with MemoryHigh at the budget (past it the kernel reclaims
# and swaps inside the slice) and MemoryMax a margin above (past that it
# OOM-kills a VM; the job fails and the slot starts a fresh one).
# auto = RAM minus HOST_RESERVE_GB; a size like 24G; off = no shared ceiling
# and no waiting, each slot capped at its own size only.
#FLEET_MEM=auto
# How far the slots' combined full sizes may exceed FLEET_MEM when
# `capacity` recommends a slot count. 100 = never more than fits at full
# size; 200 lets a 24G budget carry 16G + 4 x 8G slots, the extra ones
# waiting for memory whenever the others are busy.
#MEM_OVERCOMMIT_PCT=100
# Compressed swap in RAM (systemd-zram-generator), set up by deps/repair. It
# is what lets the slice's MemoryHigh slow an overgrown fleet down instead of
# the kernel killing a VM. The size is a zram-generator expression in MiB.
#HOST_ZRAM=1
#HOST_ZRAM_SIZE='min(ram / 4, 8192)'

# Expose VMX/SVM to the guest. Off by default: nested virt widens the KVM
# attack surface that the whole isolation model rests on. With 1 (x64 only) the
# guest runner can open /dev/kvm, runners register with an extra `kvm` label so
# Android emulator jobs can ask for it, and the host kvm module needs nested=1
# (`doctor` checks). Enable it on bare metal only, never on a host that is
# itself a VM.
NESTED_VIRT=0
# QEMU -cpu model. `host` passes the host CPU through (fastest, and what the
# VMX/SVM masking above is applied to).
#VM_CPU=host

# --- architecture -----------------------------------------------------------
# Derived from uname -m: x86_64 hosts get x64 runners, amd64 cloud images,
# qemu-system-x86_64 and the q35 machine; aarch64 hosts get arm64 runners,
# arm64 images, qemu-system-aarch64 and the virt machine with AAVMF firmware.
# The arm64 path is parametrized but untested here; override any piece.
#HOST_ARCH=
#RUNNER_ARCH=
#CLOUDIMG_ARCH=
#QEMU_BIN=
#QEMU_MACHINE=
#QEMU_PACKAGE=

# QEMU seccomp sandbox: obsolete syscalls, privilege elevation, spawning and
# resource-control syscalls are denied to the QEMU process. Set to 0 only
# while debugging a QEMU that refuses to start.
#QEMU_SANDBOX=1
# Appended verbatim to the QEMU command line, after everything gha-vm sets.
#QEMU_EXTRA_ARGS=

# --- job lifecycle ----------------------------------------------------------
# Hard ceiling on one job, matching GitHub's own 6h limit.
MAX_LIFETIME=21600
# Kill a VM that never reaches the runner. Catches a broken golden image before
# it burns a slot for six hours.
BOOT_TIMEOUT=420
# Refuse to start a VM below this much free space under STATE_DIR.
MIN_FREE_GB=20
# On stop (systemctl stop, reboot, `gha-vm.sh restart`) a slot with a job in
# flight waits this long for the job to finish before the VM is killed; an
# idle slot is stopped at once. The
# unit's TimeoutStopSec is this plus 120s, covering the VM kill and the
# deregistration call that follow.
#STOP_GRACE_SEC=900
# Deregister this slot's runner from GitHub when the supervisor stops, so a
# reboot leaves no offline runner behind.
#REAP_ON_STOP=1
# Seconds between routine sweeps for stale runners belonging to this slot.
# Failed or timed-out boots are reaped immediately regardless.
#REAP_INTERVAL=3600
# JIT registration failures back off 30s, 60s, ... up to this ceiling.
#JIT_BACKOFF_MAX=600
# With AUTH_MODE=app the JWT carries a timestamp GitHub checks, so the first
# mint after boot waits up to this long for NTP sync before proceeding anyway.
#CLOCK_SYNC_WAIT=120

# --- isolation --------------------------------------------------------------
# Refuse to start a slot unless the nftables isolation rules are loaded. Set to
# 0 only if you deliberately want jobs to reach this host and your LAN.
REQUIRE_ISOLATION=1
# Destinations jobs may reach even though they fall inside a blocked range,
# e.g. an internal package mirror or a Docker registry on the LAN. Comma or
# space separated IPv4/IPv6 CIDRs; matched before every drop rule.
#NET_ALLOW_CIDRS=
# Also drop CGNAT (100.64.0.0/10), IETF protocol assignments, benchmarking,
# multicast, reserved and broadcast ranges. Off restores the plain RFC1918 +
# link-local + loopback drop list.
#NET_BLOCK_EXTRA=1
# Drop the host's own global addresses so a job cannot reach services bound
# to the host's public IP. Refreshed at every slot start.
#NET_BLOCK_HOST_ADDRS=1
# Pin the resolvers and host addresses instead of discovering them from
# /etc/resolv.conf (and systemd-resolved's copy) / ip addr at each slot start.
# Normally leave both empty. A resolver pin on a systemd-resolved host must
# include 127.0.0.53, or the supervisor's own lookups lose their hole.
#NET_DNS_ADDRS=
#NET_HOST_ADDRS=

# --- host setup -------------------------------------------------------------
# unattended-upgrades, apt-daily and an unfinished do-release-upgrade all hold
# the apt locks. `deps` waits this long per attempt rather than failing.
APT_LOCK_WAIT=120
APT_LOCK_TRIES=5
# `deps` installs unattended-upgrades and enables daily security updates.
#HOST_UNATTENDED=1
# Let unattended-upgrades reboot the host when a kernel or libc update needs
# it. Shutdown stops the slot units, and a job in flight gets STOP_GRACE_SEC
# to finish before its VM is killed. Off by default; turn on for a hands-off
# host.
#HOST_AUTO_REBOOT=0
#HOST_AUTO_REBOOT_TIME=04:30

# --- host profile -----------------------------------------------------------
# One checkout can serve a fleet. `deps` installs profiles/*.env to
# /etc/gha-vm/profiles/ and each host loads one: <HOST_PROFILE>.env when
# HOST_PROFILE is set here or in the environment, else <machine-id>.env, else
# <short hostname>.env; default.env when the chosen file is absent; none when
# that is absent too.
# A profile is sourced AFTER this file, so anything it sets wins -- keep
# credentials and scope here, sizing there. See `gha-vm.sh profile`.
# /etc/gha-vm/profiles/local.env is sourced after the profile and is never
# touched by `deps`; setup.sh writes the sizing answers there.
#HOST_PROFILE=

# --- capacity planning ------------------------------------------------------
# A floor, not the final value. With AUTOTUNE=1 the reserve is raised to cover
# whatever is resident when capacity runs, so a box that also serves other
# workloads is sized on its real spare memory rather than its nameplate.
HOST_RESERVE_GB=8
AUTOTUNE=1
AUTOTUNE_HEADROOM_GB=4
CPU_OVERCOMMIT=2
DISK_PER_SLOT_GB=30

# Hard ceiling on slots regardless of what the hardware could carry. 0 = let
# the hardware decide. Normally set in a profile, not here.
MAX_SLOTS=0

# --- host paths -------------------------------------------------------------
# Put this on NVMe. Every job writes a fresh qcow2 overlay here.
STATE_DIR=/var/lib/gha-vm
GHA_USER=gha
