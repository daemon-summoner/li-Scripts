# li-Scripts configuration -- sample values.
#
# Copy this to config/config.env (git-ignored) and edit, or just run `./li setup`
# once and it will create config.env for you. Values here are only defaults:
# any variable already set in your environment wins, e.g.
#   LI_SCP_HOST=10.0.0.5 ./li scp -s file.txt /tmp/file.txt
#
# This file is sourced by bash. Keep it to KEY=value. The `: "${X:=y}"` form
# assigns only when X is unset, so your environment always overrides the file.

# --- identity (used by setup/git-config) --------------------------------------
: "${LI_GIT_NAME:=Sellitus}"
: "${LI_GIT_EMAIL:=sellitus@gmail.com}"
: "${LI_GIT_EDITOR:=nvim}"

# A public SSH key appended to ~/.ssh/authorized_keys by the server module.
# Only applied when this file is your real config.env, never from the sample.
: "${LI_SSH_AUTHORIZED_KEY:=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPuPn0cnBDl7BOEecgcbrWvM+dIBuKZZaRYRMqoYv2Aw sellitus@ss-MacBook-Pro.local}"

# Google Cloud project for the gemini CLI alias. Leave empty to skip the alias.
: "${LI_GCP_PROJECT:=main-416722}"

# --- setup preferences --------------------------------------------------------
: "${LI_TIMEZONE:=America/Chicago}"
: "${LI_PYTHON_VERSION:=3.13}"
: "${LI_GO_VERSION:=1.25.4}"
: "${LI_NODE_VERSION:=lts}"
# Apple Silicon unified-memory cap for GPU use, in MB (macos-tweaks module).
: "${LI_VRAM_LIMIT_MB:=114688}"

# --- file transfer (network/scp-helper, network/rsync-sync) -------------------
: "${LI_REMOTE_USER:=sellitus}"
: "${LI_SSH_KEY:=$HOME/.ssh/id_ed25519}"
: "${LI_SCP_HOST:=192.168.6.75}"
: "${LI_RSYNC_HOST:=192.168.50.150}"
: "${LI_RSYNC_KEY:=$HOME/.ssh/id_rsa.desktop}"
: "${LI_RSYNC_DEST:=/home/sellitus/SYNC}"
